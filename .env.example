# Laarish Academics environment variables.
# Copy to `.env` for local development. Never commit real secrets.

# ---------------------------------------------------------------------------
# AI Mentor (server-side only - never exposed to the browser)
# ---------------------------------------------------------------------------
# When ANTHROPIC_API_KEY is empty, the mentor runs in clearly labelled demo mode
# (rule-based answers for the sample lessons). Set it to enable Claude.
ANTHROPIC_API_KEY=

# Provider selection: auto (Claude when a key is present, else demo) | demo | claude
MENTOR_PROVIDER=auto
# Claude model used by the mentor.
MENTOR_MODEL=claude-opus-5-5
# Effort for mentor replies: low | medium | high. Short chat answers work well at low.
MENTOR_EFFORT=low
# Provider timeout in milliseconds (3000-60000).
MENTOR_TIMEOUT_MS=20000
# Upper bound on reply length in tokens (512-8192). Replies are prompted to stay
# under ~80 words, so this is a safety cap, not a target.
MENTOR_MAX_TOKENS=2048
# Requests allowed per client IP per 5-minute window (in-memory, per server instance).
MENTOR_RATE_LIMIT=30

# ---------------------------------------------------------------------------
# Lesson media (public - exposed to the browser at build time)
# ---------------------------------------------------------------------------
# Official topic videos are listed in public/media/manifest.json, keyed by the
# video id in the curriculum (see README). To load the manifest from elsewhere
# (for example a CDN), set its URL here. Leave empty to use /media/manifest.json.
# Topics without a configured video show a clearly labelled temporary explainer.
VITE_MEDIA_MANIFEST_URL=

# Port for the standalone production server (npm start).
PORT=3000
