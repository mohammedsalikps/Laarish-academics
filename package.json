{
  "name": "laarish-academics",
  "private": true,
  "version": "0.1.0",
  "description": "Laarish Academics: a gamified, interactive learning platform for children in Classes 1-8.",
  "homepage": "https://laarish-academics.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammedsalikps/Laarish-academics.git"
  },
  "bugs": {
    "url": "https://github.com/mohammedsalikps/Laarish-academics/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/node-server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "mentor:check": "esbuild server/scripts/liveCheck.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/live-check.mjs --log-level=warning && node --env-file-if-exists=.env dist-server/live-check.mjs",
    "media:check": "esbuild server/scripts/mediaCheck.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/media-check.mjs --log-level=warning && node dist-server/media-check.mjs",
    "curriculum:report": "esbuild server/scripts/curriculumReport.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/curriculum-report.mjs --log-level=warning && node dist-server/curriculum-report.mjs",
    "curriculum:index": "esbuild server/scripts/topicIndex.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/topic-index.mjs --log-level=warning && node dist-server/topic-index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
