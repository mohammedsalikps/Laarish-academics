# Store text with LF line endings in the repository, whatever the contributor's OS.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated files: collapse in diffs.
shared/curriculum/topicIndex.ts linguist-generated=true
docs/curriculum-status.md linguist-generated=true
package-lock.json linguist-generated=true
